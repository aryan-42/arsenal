filters:
  or:
    - file.inFolder("04 Evidence")
    - file.inFolder("03 Sources")
views:
  - type: table
    name: Unverified stats
    filters:
      and:
        - file.inFolder("04 Evidence")
        - kind == "stat"
        - verified == false
    order:
      - file.name
      - value
      - unit
      - year
      - geography
      - incomplete
      - source
    sort:
      - property: captured
        direction: ASC
  - type: table
    name: All evidence
    filters:
      and:
        - file.inFolder("04 Evidence")
    order:
      - file.name
      - kind
      - verified
      - domains
      - use_for
      - captured
    groupBy:
      property: kind
      direction: ASC
  - type: table
    name: Case examples
    filters:
      and:
        - file.inFolder("04 Evidence")
        - kind == "case"
    order:
      - file.name
      - company
      - result
      - domains
  - type: table
    name: Opportunities
    filters:
      and:
        - file.inFolder("04 Evidence")
        - kind == "opportunity"
    order:
      - file.name
      - problem
      - who_has_it
      - why_now
      - captured
  - type: table
    name: Sources
    filters:
      and:
        - file.inFolder("03 Sources")
    order:
      - file.name
      - format
      - status
      - cards
      - captured
    sort:
      - property: captured
        direction: DESC
