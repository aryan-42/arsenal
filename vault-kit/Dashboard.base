filters:
  or:
    - file.inFolder("01 Ideas")
    - file.inFolder("03 Sources")
views:
  - type: table
    name: My ideas
    filters:
      and:
        - file.inFolder("01 Ideas")
    order:
      - file.name
      - status
      - topics
      - source
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Books
    filters:
      and:
        - file.inFolder("03 Sources")
        - format == "book"
    order:
      - file.name
      - author
      - status
      - started
      - finished
  - type: table
    name: Sources
    filters:
      and:
        - file.inFolder("03 Sources")
        - format != "book"
    order:
      - file.name
      - format
      - topics
      - captured
    sort:
      - property: captured
        direction: DESC
