# ---------- Required ----------
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Any random string (letters, numbers, _ and - only). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user id (get it from @userinfobot). Only this user can use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Supabase: Project Settings -> API
SUPABASE_URL=
# The secret key (sb_secret_...) or legacy service_role key. Server-only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic console -> API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# GitHub fine-grained token with Contents: Read and write on the vault repo only
GITHUB_TOKEN=
# owner/repo of your Obsidian vault repository
GITHUB_REPO=
GITHUB_BRANCH=main

# Random string; Vercel sends it to cron routes automatically
CRON_SECRET=

# ---------- Vault layout (match your folders) ----------
# Subfolder of the repo that holds the vault; leave empty if the vault is the repo root
VAULT_ROOT=
VAULT_INBOX_DIR=00 Inbox
VAULT_SOURCES_DIR=03 Sources
VAULT_EVIDENCE_DIR=04 Evidence

# ---------- Optional ----------
# Semantic search (recommended). Without it, search is keyword-only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# Voice notes -> text (Groq Whisper). Without it, send text notes.
GROQ_API_KEY=
# Fallback when YouTube blocks transcript fetching from Vercel
SUPADATA_API_KEY=
# Override the default description of how you use the evidence bank
OWNER_CONTEXT=
