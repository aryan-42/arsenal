# ---------- Required ----------
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Any random string (letters, numbers, _ and - only). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user id (get it from @userinfobot). Only this user can use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Supabase: Project Settings -> API
SUPABASE_URL=
# The secret key (sb_secret_...) or legacy service_role key. Server-only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Model provider (pick ONE) ----------
# anthropic (default) | openrouter | nvidia | openai (any OpenAI-compatible API)
LLM_PROVIDER=anthropic

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# If LLM_PROVIDER=openrouter or nvidia
LLM_API_KEY=
# Copy the exact model id from the provider's model page (OpenRouter free ids end in :free)
LLM_MODEL=
# Optional comma-separated backups, tried in order when a model is rate-limited or down
LLM_FALLBACK_MODELS=
# Optional: only needed for providers without a preset
LLM_BASE_URL=
# Lower this if a model rejects large outputs
LLM_MAX_OUTPUT_TOKENS=8000
# Lower this for models with small context windows (characters of source text sent)
MAX_SOURCE_CHARS=80000

# GitHub fine-grained token with Contents: Read and write on the vault repo only
GITHUB_TOKEN=
# owner/repo of your Obsidian vault repository
GITHUB_REPO=
GITHUB_BRANCH=main

# Random string; Vercel sends it to cron routes automatically
CRON_SECRET=

# ---------- Vault layout (match your folders) ----------
# Subfolder of the repo that holds the vault; leave empty if the vault is the repo root
VAULT_ROOT=
VAULT_INBOX_DIR=00 Inbox
VAULT_IDEAS_DIR=01 Ideas
VAULT_SOURCES_DIR=03 Sources
VAULT_TOPICS_DIR=04 Topics
VAULT_REVIEWS_DIR=05 Reviews
VAULT_ARCHIVE_DIR=90 Archive

# ---------- Optional ----------
# Semantic search (recommended). Without it, search is keyword-only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# Voice notes -> text (Groq Whisper). Without it, send text notes.
GROQ_API_KEY=
# Fallback when YouTube blocks transcript fetching from Vercel
SUPADATA_API_KEY=
# Override the default description of how you use the evidence bank
OWNER_CONTEXT=

# ---------- Commonplace book ----------
# Password for the dashboard at your Vercel URL (required to open it)
DASHBOARD_PASSWORD=
# Your vault's name exactly as shown in Obsidian, so dashboard links open notes
OBSIDIAN_VAULT_NAME=
# Comma-separated starting topics (optional; a default list of 15 is used otherwise)
TOPICS=
# Vision model for reading page photos when using OpenRouter/NVIDIA (optional; Claude reads photos by default)
VISION_MODEL=
